{
  "name": "solution-practices",
  "version": "0.16.1",
  "description": "Canonical skill definitions for AI coding agents that build, review, and deploy Huawei Cloud Solution Practices",
  "type": "module",
  "files": [
    ".claude/CLAUDE.md",
    ".claude/agents/*.md",
    ".claude/skills/sac-*/SKILL.md",
    ".claude/skills/query-huawei-cloud-prices/SKILL.md",
    "skills/**/*",
    "scripts/tests/**/*.py",
    "docs/contracts/*.md",
    "project.config.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:project": ".venv-sac/bin/python -m scripts.tests.runner",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run pack:check"
  },
  "keywords": [
    "claude-code",
    "ai-coding-tools",
    "terraform",
    "huawei-cloud",
    "solution-practices",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justin-TangPan/solution-practices.git"
  },
  "bugs": {
    "url": "https://github.com/Justin-TangPan/solution-practices/issues"
  },
  "homepage": "https://github.com/Justin-TangPan/solution-practices#readme",
  "license": "MIT",
  "sac": {
    "manifestSchemaVersion": 1,
    "contentVersion": "2026.08.11"
  }
}
