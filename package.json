{
  "name": "solution-practices",
  "version": "0.14.0",
  "description": "Solution Practice engineering assets and Terraform workflows for AI coding tools",
  "type": "module",
  "bin": {
    "sac": "bin/sac.js"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "assets/templates/hermes_agent_inline.tf",
    ".codex/config.toml",
    ".codex/agents/*.md",
    ".codex/agents/*.toml",
    ".codex/workflows/*.md",
    ".claude/CLAUDE.md",
    ".claude/agents/*.md",
    ".claude/agents/*.json",
    ".claude/skills/sac-*/SKILL.md",
    ".claude/skills/query-huawei-cloud-prices/SKILL.md",
    ".claude/workflows/*.js",
    "skills/**/*",
    "skills-index.json",
    "practices/**/*",
    "scripts/tests/**/*.py",
    "scripts/document_pipeline/**/*.py",
    "scripts/document_pipeline/config/*.json",
    "scripts/document_pipeline/templates/*.docx",
    "requirements-document-pipeline.txt",
    "docs/contracts/*.md",
    "docs/agent-skill-migration.md",
    "docs/coding-agent-adapters.md",
    "docs/project-boundaries.md",
    "docs/project-state.md",
    "docs/source-of-truth.md",
    "reference/docs/*.md",
    "project.config.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:project": ".venv-sac/bin/python -m scripts.tests.runner",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run pack:check"
  },
  "keywords": [
    "codex",
    "ai-coding-tools",
    "terraform",
    "huawei-cloud",
    "rfs",
    "solution-practices"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justin-TangPan/solution-practices.git"
  },
  "bugs": {
    "url": "https://github.com/Justin-TangPan/solution-practices/issues"
  },
  "homepage": "https://github.com/Justin-TangPan/solution-practices#readme",
  "license": "MIT",
  "sac": {
    "manifestSchemaVersion": 1,
    "contentVersion": "2026.08.07"
  }
}
