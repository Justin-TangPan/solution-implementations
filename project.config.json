{
  "agent_capabilities": {
    "supported_runtimes": [
      "claude-code"
    ],
    "core_roles": {
      "architect": {
        "mandatory_skills": [
          "sac-project",
          "sac-architecture"
        ],
        "conditional_skills": [
          "sac-deep-search"
        ]
      },
      "builder": {
        "mandatory_skills": [
          "sac-project",
          "sac-implementation"
        ],
        "conditional_skills": [
          "sac-documentation",
          "query-huawei-cloud-prices"
        ]
      },
      "reviewer": {
        "mandatory_skills": [
          "sac-project",
          "sac-quality"
        ],
        "conditional_skills": []
      }
    },
    "skills": {
      "core": [
        "sac-project",
        "sac-architecture",
        "sac-implementation",
        "sac-quality",
        "sac-documentation"
      ],
      "optional": [
        "sac-deep-search",
        "sac-page-enhance",
        "query-huawei-cloud-prices"
      ]
    },
    "task_flows": {
      "small-change": [
        "builder"
      ],
      "maintain-practice": [
        "builder",
        "reviewer"
      ],
      "architecture-change": [
        "architect",
        "builder",
        "reviewer"
      ],
      "new-practice": [
        "architect",
        "builder",
        "reviewer",
        "builder"
      ],
      "review-practice": [
        "reviewer"
      ],
      "documentation-change": [
        "builder"
      ]
    },
    "workflows": {
      "enabled": true,
      "default": "new-practice",
      "definitions": {
        "new-practice": "workflows/new-practice.yaml",
        "maintain-practice": "workflows/maintain-practice.yaml",
        "architecture-change": "workflows/architecture-change.yaml",
        "small-change": "workflows/small-change.yaml",
        "review-practice": "workflows/review-practice.yaml",
        "documentation-change": "workflows/documentation-change.yaml"
      },
      "state_file": ".var/workflow-state.json",
      "plan_b_entry": "stages/README.md"
    },
    "adapters": {
      "claude-code": {
        "instructions": ".claude/CLAUDE.md",
        "skill_discovery": ".claude/skills",
        "agents": ".claude/agents",
        "workflows": "skills-and-subagents"
      }
    }
  }
}
