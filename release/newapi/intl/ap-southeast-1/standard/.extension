{
  "variables": {
    "grouping": {
      "network_config": {
        "label": "Network Configuration",
        "description": "Configure VPC, security group and EIP bandwidth"
      },
      "ecs_config": {
        "label": "ECS Configuration",
        "description": "Configure server name, flavor, password and system disk"
      },
      "charging_config": {
        "label": "Billing Configuration",
        "description": "Configure billing mode and purchase period"
      }
    }
  },
  "i18n": {
    "en-us": {
      "variable": {
        "vpc_name": { "description": "VPC name, 1-54 characters. A new VPC is created and duplicate names are not allowed. Default: building-a-newapi-llm-gateway-demo" },
        "security_group_name": { "description": "Security group name, 1-64 characters. A new security group is created. Default: building-a-newapi-llm-gateway-demo" },
        "ecs_name": { "description": "ECS instance name, 1-64 characters. Duplicate names are not supported. Default: building-a-newapi-llm-gateway-demo" },
        "ecs_flavor": { "description": "ECS or Flexus X instance flavor. Default: x1.8u.16g" },
        "ecs_password": { "description": "ECS root password, 8-26 characters, containing at least three of uppercase letters, lowercase letters, digits and special characters" },
        "system_disk_size": { "description": "ECS system disk size in GB. Range: 40-1024. Default: 100" },
        "bandwidth_size": { "description": "EIP bandwidth in Mbit/s, billed by traffic. Range: 1-300. Default: 300" },
        "charging_mode": { "description": "Billing mode: postPaid or prePaid. Default: postPaid" },
        "charging_unit": { "description": "Subscription unit: month or year. Required for prePaid. Default: month" },
        "charging_period": { "description": "Subscription period: 1-9 months or 1-3 years. Required for prePaid. Default: 1" }
      }
    },
    "zh-cn": {
      "variable": {
        "vpc_name": { "description": "VPC名称，1-54字符。模板将新建VPC，不允许重名。默认：building-a-newapi-llm-gateway-demo" },
        "security_group_name": { "description": "安全组名称，1-64字符。模板将新建安全组。默认：building-a-newapi-llm-gateway-demo" },
        "ecs_name": { "description": "云服务器实例名称，1-64字符，不支持重名。默认：building-a-newapi-llm-gateway-demo" },
        "ecs_flavor": { "description": "ECS或Flexus X实例规格。默认：x1.8u.16g" },
        "ecs_password": { "description": "云服务器root密码，8-26位，至少包含大写字母、小写字母、数字和特殊字符中的三种" },
        "system_disk_size": { "description": "云服务器系统盘大小（GB），取值范围40-1024。默认：100" },
        "bandwidth_size": { "description": "弹性公网带宽（Mbit/s），按流量计费，取值范围1-300。默认：300" },
        "charging_mode": { "description": "计费模式：postPaid（按需）或prePaid（包年包月）。默认：postPaid" },
        "charging_unit": { "description": "订购周期类型：month（月）或year（年），prePaid时必填。默认：month" },
        "charging_period": { "description": "订购周期：按月1-9，按年1-3，prePaid时必填。默认：1" }
      }
    }
  }
}
