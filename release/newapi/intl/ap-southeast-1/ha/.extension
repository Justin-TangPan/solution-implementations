{
  "variables": {
    "grouping": {
      "cce_config": {
        "label": "CCE Cluster Configuration",
        "description": "Configure the CCE cluster and node pool"
      },
      "database_config": {
        "label": "Database and Cache Configuration",
        "description": "Configure RDS for MySQL and DCS Redis"
      },
      "newapi_config": {
        "label": "New API Configuration",
        "description": "Configure New API session and encryption secrets"
      },
      "charging_config": {
        "label": "Billing Configuration",
        "description": "Configure billing mode and purchase period"
      }
    }
  },
  "i18n": {
    "en-us": {
      "variable": {
        "resource_name_prefix": { "description": "Resource name prefix, 4-24 characters, using lowercase letters, digits and hyphens, and starting with a lowercase letter. Default: ha-new-api" },
        "cce_cluster_flavor": { "description": "CCE Turbo cluster flavor. Options: cce.s2.small/medium/large/xlarge. Default: cce.s2.small" },
        "cce_node_pool_password": { "description": "CCE node password, 8-24 characters, containing uppercase and lowercase letters plus a digit or special character" },
        "cce_node_pool_flavor": { "description": "CCE node ECS or Flexus X instance flavor. Default: x1.8u.16g" },
        "cce_node_pool_count": { "description": "Initial CCE node pool count, maximum 10. Default: 3" },
        "rds_flavor": { "description": "RDS for MySQL primary/standby flavor. Default: rds.mysql.n1.xlarge.2.ha" },
        "mysql_password": { "description": "MySQL administrator password, 8-24 characters, containing uppercase and lowercase letters plus a digit or special character" },
        "mysql_user_password": { "description": "New API MySQL user password, 8-24 characters. It cannot equal the username or its reverse" },
        "redis_capacity": { "description": "DCS Redis capacity in GB. Options: 1/2/4/8/16/32/64. Default: 1" },
        "redis_password": { "description": "Redis password, 8-24 characters, containing uppercase and lowercase letters plus a digit or special character" },
        "session_secret": { "description": "New API management session secret, 8-24 characters, containing uppercase and lowercase letters plus a digit or special character" },
        "crypto_secret": { "description": "Secret used to encrypt model API keys, 8-24 characters, containing uppercase and lowercase letters plus a digit or special character" },
        "charging_mode": { "description": "Billing mode: postPaid or prePaid. Default: postPaid" },
        "charging_unit": { "description": "Subscription unit: month or year. Required for prePaid. Default: month" },
        "charging_period": { "description": "Subscription period: 1-9 months or 1-3 years. Required for prePaid. Default: 1" }
      }
    },
    "zh-cn": {
      "variable": {
        "resource_name_prefix": { "description": "资源名称前缀，4-24字符，支持小写字母、数字和中划线，须以小写字母开头。默认：ha-new-api" },
        "cce_cluster_flavor": { "description": "CCE Turbo集群规格，可选cce.s2.small/medium/large/xlarge。默认：cce.s2.small" },
        "cce_node_pool_password": { "description": "CCE节点密码，8-24位，须包含大写字母、小写字母以及数字或特殊字符" },
        "cce_node_pool_flavor": { "description": "CCE节点ECS或Flexus X实例规格。默认：x1.8u.16g" },
        "cce_node_pool_count": { "description": "CCE节点池初始节点数，最大10。默认：3" },
        "rds_flavor": { "description": "RDS for MySQL主备实例规格。默认：rds.mysql.n1.xlarge.2.ha" },
        "mysql_password": { "description": "MySQL管理员密码，8-24位，须包含大写字母、小写字母以及数字或特殊字符" },
        "mysql_user_password": { "description": "New API数据库用户密码，8-24位，不能与用户名或用户名倒序相同" },
        "redis_capacity": { "description": "DCS Redis容量（GB），可选1/2/4/8/16/32/64。默认：1" },
        "redis_password": { "description": "Redis密码，8-24位，须包含大写字母、小写字母以及数字或特殊字符" },
        "session_secret": { "description": "New API管理后台会话密钥，8-24位，须包含大写字母、小写字母以及数字或特殊字符" },
        "crypto_secret": { "description": "用于加密大模型API密钥的加密密钥，8-24位，须包含大写字母、小写字母以及数字或特殊字符" },
        "charging_mode": { "description": "计费模式：postPaid（按需）或prePaid（包年包月）。默认：postPaid" },
        "charging_unit": { "description": "订购周期类型：month（月）或year（年），prePaid时必填。默认：month" },
        "charging_period": { "description": "订购周期：按月1-9，按年1-3，prePaid时必填。默认：1" }
      }
    }
  }
}
